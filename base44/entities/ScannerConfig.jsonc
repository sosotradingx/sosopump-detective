{
  "name": "ScannerConfig",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "Default",
      "description": "Config name"
    },
    "pump_threshold": {
      "type": "number",
      "default": 15,
      "description": "Min pump %"
    },
    "volume_multiplier": {
      "type": "number",
      "default": 2.5,
      "description": "Volume spike multiplier"
    },
    "lookback_bars": {
      "type": "number",
      "default": 20,
      "description": "Lookback bars"
    },
    "adaptive_lookback": {
      "type": "boolean",
      "default": true
    },
    "inactive_timeout": {
      "type": "number",
      "default": 50
    },
    "require_2tf_confirmation": {
      "type": "boolean",
      "default": true
    },
    "tf_current": {
      "type": "string",
      "default": "1h"
    },
    "tf_mid": {
      "type": "string",
      "default": "4h"
    },
    "tf_high": {
      "type": "string",
      "default": "1d"
    },
    "tf_low": {
      "type": "string",
      "default": "15m"
    },
    "enable_early_detection": {
      "type": "boolean",
      "default": true
    },
    "use_volume_accumulation": {
      "type": "boolean",
      "default": true
    },
    "vol_accum_threshold": {
      "type": "number",
      "default": 1.3
    },
    "require_breakout": {
      "type": "boolean",
      "default": true
    },
    "use_macd_confirmation": {
      "type": "boolean",
      "default": true
    },
    "use_bullish_divergence": {
      "type": "boolean",
      "default": false
    },
    "use_obv_divergence": {
      "type": "boolean",
      "default": true
    },
    "use_bb_squeeze": {
      "type": "boolean",
      "default": true
    },
    "use_adx_filter": {
      "type": "boolean",
      "default": true
    },
    "use_stoch_divergence": {
      "type": "boolean",
      "default": false
    },
    "use_vwap_accumulation": {
      "type": "boolean",
      "default": true
    },
    "use_trend_filter": {
      "type": "boolean",
      "default": true
    },
    "obv_lookback": {
      "type": "number",
      "default": 14
    },
    "bb_length": {
      "type": "number",
      "default": 20
    },
    "bb_mult": {
      "type": "number",
      "default": 2
    },
    "bb_squeeze_threshold": {
      "type": "number",
      "default": 0.8
    },
    "adx_threshold": {
      "type": "number",
      "default": 20
    },
    "stoch_length": {
      "type": "number",
      "default": 14
    },
    "enable_take_profit": {
      "type": "boolean",
      "default": true
    },
    "take_profit_level": {
      "type": "number",
      "default": 30
    },
    "enable_stop_loss": {
      "type": "boolean",
      "default": true
    },
    "stop_loss_level": {
      "type": "number",
      "default": 5
    },
    "volume_fade_threshold": {
      "type": "number",
      "default": 0.5
    },
    "noise_filter": {
      "type": "boolean",
      "default": true
    },
    "noise_threshold": {
      "type": "number",
      "default": 0.5
    },
    "use_market_regime": {
      "type": "boolean",
      "default": true
    },
    "exhaustion_rsi": {
      "type": "number",
      "default": 75
    },
    "volume_decline_threshold": {
      "type": "number",
      "default": 0.7
    },
    "price_retrace_threshold": {
      "type": "number",
      "default": 10
    },
    "max_pairs": {
      "type": "number",
      "default": 50
    },
    "refresh_interval": {
      "type": "number",
      "default": 30
    },
    "quote_asset": {
      "type": "string",
      "enum": [
        "USDT",
        "BUSD",
        "BTC",
        "ETH"
      ],
      "default": "USDT"
    },
    "min_volume_24h": {
      "type": "number",
      "default": 1000000
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}